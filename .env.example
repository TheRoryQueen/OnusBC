# Onus environment variables. Copy to .env.local and fill in values.
# Never commit real values. Keep every key in the 1Password "Onus" vault.

# Supabase (browser and server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key: server routes and scripts only, never the browser
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (scripts only: migrations and scripts/test-db).
# Supabase dashboard > Connect > Session pooler URI, with the database password filled in.
SUPABASE_DB_URL=

# Google Gemini: /api/ask, grading and embedding scripts
GEMINI_API_KEY=

# ElevenLabs: /api/voice routes
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Map (MapLibre + CARTO, no key needed)
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Judge access: /api/judge-login
JUDGE_EVENT_CODE=

# Auth redirects: http://localhost:3000 locally, https://onusbc.tech in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true for the event (demo ratings count in scores), false excludes them
DEMO_MODE=true
